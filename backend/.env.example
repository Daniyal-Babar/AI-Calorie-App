# Database (defaults to SQLite if DATABASE_URL is unset)
# DATABASE_URL=postgresql://calorie_user:calorie_password@localhost:5432/calorie_db

# Security & Tokens
SECRET_KEY=dev-secret-calorie-key-change-in-production
JWT_SECRET_KEY=jwt-super-secret-key-nutrition-agent

# ==========================================
# LLM Provider Configuration ('gemini' or 'ollama')
# ==========================================
LLM_PROVIDER=ollama

# Google Gemini Settings (Used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_VISION_MODEL=gemini-flash-lite-latest

# Local Ollama Settings (Used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3:4b
# Other supported Ollama models with function calling:
# OLLAMA_MODEL=qwen2.5-coder:3b
# OLLAMA_MODEL=llama3.1:8b

AGENT_MAX_ITERATIONS=5

# Server & CORS
FLASK_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
