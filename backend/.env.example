# Database (defaults to SQLite if DATABASE_URL is unset)
# DATABASE_URL=postgresql://calorie_user:calorie_password@localhost:5432/calorie_db

# Security & Tokens
SECRET_KEY=dev-secret-calorie-key-change-in-production
JWT_SECRET_KEY=jwt-super-secret-key-nutrition-agent

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_VISION_MODEL=gemini-flash-lite-latest
GEMINI_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash
AGENT_MAX_ITERATIONS=5

# Server & CORS
FLASK_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
